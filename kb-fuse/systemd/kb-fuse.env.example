# Copy to ~/.config/kb-fuse/env (chmod 0600 recommended, though no tokens are stored here).
# NOTE: systemd EnvironmentFile does NOT expand $HOME or ~; use full paths.

KB_BASE_URL=https://kb.mgt.moe
KB_MOUNT_POINT=/home/YOUR_USER/kb
KB_CACHE_DIR=/home/YOUR_USER/.cache/kb-fuse
AGENT_OAUTH_FILE=/home/YOUR_USER/projects/agent-knowledge/.auth/oauth.json

# Optional overrides:
# KB_OAUTH_SCRIPT=/home/YOUR_USER/projects/agent-knowledge/scripts/agent-oauth.mjs
# KB_DOC_TTL_SECS=300
# KB_TREE_TTL_SECS=60
# KB_MAX_CONCURRENT_FETCH=4
# KB_IPV4_ONLY=1
# KB_NEEDS_LOGIN_WEBHOOK=
# RUST_LOG=info
